# NoMagic build of a lighthouse component. Base images come from our Artifact
# Registry Docker Hub mirror; runtime layer mirrors docker/<component>/Dockerfile.
#
# Build and push (from the repo root, tag = <upstream>-nomagic-vN):
#   docker build -f Dockerfile.nomagic --platform linux/amd64 \
#     --build-arg COMPONENT=webhooks --build-arg VERSION=1.33.6-nomagic-v1 \
#     -t europe-west3-docker.pkg.dev/cicd-nomagic-ai/images/lighthouse-webhooks:1.33.6-nomagic-v1 .
#   docker build -f Dockerfile.nomagic --platform linux/amd64 \
#     --build-arg COMPONENT=tektoncontroller --build-arg VERSION=1.33.6-nomagic-v1 \
#     -t europe-west3-docker.pkg.dev/cicd-nomagic-ai/images/lighthouse-tekton-controller:1.33.6-nomagic-v1 .
#   docker push <image>
ARG MIRROR=europe-west3-docker.pkg.dev/management-nomagic-ai/dockerhub-mirror

# Build stage runs on the builder's native arch; go cross-compiles to amd64.
# The Go version tracks go.mod (1.26 since upstream 1.33.x).
FROM --platform=$BUILDPLATFORM ${MIRROR}/golang:1.26 AS build
ARG COMPONENT=webhooks
ARG VERSION=dev
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
    go build -ldflags "-X github.com/jenkins-x/lighthouse/pkg/version.Version=${VERSION}" \
    -o /app cmd/${COMPONENT}/main.go

FROM ${MIRROR}/alpine:3.23
RUN apk add --update --no-cache ca-certificates git \
    && adduser -D -u 1000 jx
ENV JX_HOME=/home/jx
USER 1000
COPY --from=build /app /home/jx/app
ENTRYPOINT ["/home/jx/app"]
